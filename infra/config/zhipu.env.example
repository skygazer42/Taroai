# 智谱 OpenAI 兼容模型配置；真实密钥只通过本地环境或密钥服务注入。
TAROAI_MODEL_GATEWAY_BASE_URL=https://open.bigmodel.cn/api/paas/v4
TAROAI_MODEL_GATEWAY_MODEL=glm-4.7
TAROAI_MODEL_GATEWAY_ALLOWED_MODELS=["glm-4.7"]
TAROAI_MODEL_GATEWAY_API_KEY=
TAROAI_MODEL_GATEWAY_API_KEY_SECRET_REF_ID=
TAROAI_MODEL_GATEWAY_SECRET_LEASE_TTL_SECONDS=60
TAROAI_MODEL_GATEWAY_TIMEOUT_SECONDS=120
TAROAI_MODEL_GATEWAY_CHAT_REQUEST_OPTIONS={}
TAROAI_MODEL_GATEWAY_PROVIDERS=[]

# 独立验证器可从 ZHIPU_API_KEY 读取密钥。
TAROAI_MODEL_GATEWAY_VERIFICATION_PROFILE=
TAROAI_MODEL_GATEWAY_API_KEY_ENV_VAR=ZHIPU_API_KEY
TAROAI_MODEL_GATEWAY_VERIFICATION_SECRET_VALUE_ENV_JSON={}
