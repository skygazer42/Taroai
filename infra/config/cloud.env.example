TAROAI_DEPLOYMENT_MODE=cloud
TAROAI_ENVIRONMENT=production
TAROAI_DEPLOYMENT_EXTERNAL_URL=https://agent.example.com
TAROAI_DEPLOYMENT_CALLBACK_URL=https://agent.example.com/api/connectors/oauth/callback
TAROAI_DEPLOYMENT_STORAGE_REGION=us-east-1
TAROAI_DEPLOYMENT_SANDBOX_REGION=us-east-1
TAROAI_DEPLOYMENT_SECRET_MANAGER_TYPE=aws_secrets_manager
TAROAI_DATABASE_URL=postgresql://taroai_app:${TAROAI_DATABASE_PASSWORD}@postgres.example.com:5432/taroai
TAROAI_CONTROL_PLANE_STORE_BACKEND=sql
TAROAI_IDENTITY_SERVICE_BACKEND=sql
TAROAI_CONNECTOR_REGISTRY_BACKEND=sql
TAROAI_CUSTOMER_FEEDBACK_SERVICE_BACKEND=sql
TAROAI_SKILL_REGISTRY_BACKEND=sql
TAROAI_SOLUTION_PACK_REGISTRY_BACKEND=sql
TAROAI_SSO_PROVIDER_REGISTRY_BACKEND=sql
TAROAI_SCIM_PROVISIONING_STORE_BACKEND=sql
TAROAI_KNOWLEDGE_SERVICE_BACKEND=sql
TAROAI_LONG_TERM_MEMORY_BACKEND=sql
TAROAI_TRIGGER_STORE_BACKEND=sql
TAROAI_STORAGE_CATALOG_BACKEND=sql
TAROAI_LIFECYCLE_POLICY_BACKEND=sql
TAROAI_RESTORE_DRILL_SCHEDULE_BACKEND=sql
TAROAI_MODEL_GATEWAY_POLICY_STORE_BACKEND=sql
TAROAI_MODEL_GATEWAY_PROVIDER_STORE_BACKEND=sql
TAROAI_MODEL_GATEWAY_PROVIDER_RATE_LIMIT_BACKEND=sql
TAROAI_SHORT_TERM_MEMORY_BACKEND=redis
TAROAI_JOB_QUEUE_BACKEND=redis
TAROAI_REDIS_URL=redis://redis.example.com:6379/0
TAROAI_OBJECT_STORAGE_REGION=us-east-1
TAROAI_SANDBOX_PROVIDER=k8s
TAROAI_SANDBOX_CONTROLLER_BASE_URL=https://sandbox-controller.example.com
TAROAI_SANDBOX_CONTROLLER_API_KEY=cloud_sandbox_controller_api_key_replace_before_launch
TAROAI_SANDBOX_CONTROLLER_TIMEOUT_SECONDS=30
TAROAI_SANDBOX_CONTROLLER_PROVIDER=kubernetes
TAROAI_SANDBOX_CONTROLLER_SESSION_TTL_SECONDS=1800
TAROAI_SANDBOX_CONTROLLER_MAX_SESSIONS=50
TAROAI_SANDBOX_CONTROLLER_MAX_SESSIONS_PER_TENANT=20
TAROAI_SANDBOX_CONTROLLER_MAX_SESSIONS_PER_RUN=3
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_NAMESPACE=taroai
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_SERVICE_ACCOUNT_NAME=sandbox-runner
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_RUNTIME_CLASS_NAME=gvisor
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_RUNTIME_CLASS_REQUIRED=true
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_ALLOWED_IMAGES=["ghcr.io/creao-ai/sandbox-runtime@sha256:*"]
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_ORPHAN_CLEANUP_ENABLED=false
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_IMAGE_PULL_POLICY=IfNotPresent
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_MEMORY_LIMIT=1Gi
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_CPU_LIMIT=1000m
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_EPHEMERAL_STORAGE_LIMIT=2Gi
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_RUN_AS_USER=65532
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_RUN_AS_GROUP=65532
TAROAI_SANDBOX_PROVIDER_REGION=us-east-1
TAROAI_SECRET_SERVICE_BACKEND=aws_secrets_manager
TAROAI_SECRET_SERVICE_REGION=us-east-1
TAROAI_SECRET_SERVICE_NAME_PREFIX=taroai/cloud
TAROAI_MODEL_GATEWAY_BASE_URL=https://api.openai.com/v1
TAROAI_MODEL_GATEWAY_API_KEY_SECRET_REF_ID=
TAROAI_MODEL_GATEWAY_SECRET_LEASE_TTL_SECONDS=60
TAROAI_MODEL_GATEWAY_PROVIDERS=[]
TAROAI_MODEL_GATEWAY_SENSITIVITY_LIMITS={}
TAROAI_MODEL_GATEWAY_BUDGET_WINDOW_SECONDS=0
TAROAI_EMBEDDING_GATEWAY_ENABLED=false
TAROAI_EMBEDDING_GATEWAY_BASE_URL=https://api.openai.com/v1
TAROAI_EMBEDDING_GATEWAY_API_KEY_SECRET_REF_ID=
TAROAI_EMBEDDING_GATEWAY_SECRET_LEASE_TTL_SECONDS=60
TAROAI_EMBEDDING_GATEWAY_MODEL=
TAROAI_EMBEDDING_GATEWAY_DIMENSIONS=
TAROAI_EMBEDDING_GATEWAY_TIMEOUT_SECONDS=30
TAROAI_BILLING_PRICING_RULES=[]
TAROAI_DEV_REQUEST_HEADERS_ENABLED=false
TAROAI_PASSWORD_HASH_SALT=cloud_unique_password_hash_salt_replace_before_launch
TAROAI_ACCESS_TOKEN_SECRET=cloud_unique_access_token_secret_replace_before_launch
TAROAI_KNOWLEDGE_CHUNK_MAX_CHARACTERS=1200
TAROAI_KNOWLEDGE_CHUNK_OVERLAP_CHARACTERS=120
TAROAI_LICENSE_TRUSTED_PUBLIC_KEYS={}
TAROAI_LICENSE_RUNTIME_ENFORCEMENT_ENABLED=false
