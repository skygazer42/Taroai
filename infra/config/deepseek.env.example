# OpenAI-compatible DeepSeek model gateway profile.
# Load these non-secret values in your shell or copy them into a local .env.
# Set TAROAI_MODEL_GATEWAY_API_KEY only through a local secret manager or shell
# environment before running strict model execution verification.
TAROAI_MODEL_GATEWAY_BASE_URL=https://api.deepseek.com
TAROAI_MODEL_GATEWAY_MODEL=deepseek-v4-flash
TAROAI_MODEL_GATEWAY_API_KEY=
TAROAI_MODEL_GATEWAY_API_KEY_SECRET_REF_ID=
TAROAI_MODEL_GATEWAY_SECRET_LEASE_TTL_SECONDS=60
TAROAI_MODEL_GATEWAY_TIMEOUT_SECONDS=30
TAROAI_MODEL_GATEWAY_CHAT_REQUEST_OPTIONS={"response_format":{"type":"json_object"},"thinking":{"type":"disabled"}}
TAROAI_MODEL_GATEWAY_PROVIDERS=[]

# Verification-only convenience settings. Runtime readiness still requires
# TAROAI_MODEL_GATEWAY_API_KEY or TAROAI_MODEL_GATEWAY_API_KEY_SECRET_REF_ID.
TAROAI_MODEL_GATEWAY_VERIFICATION_PROFILE=deepseek
TAROAI_MODEL_GATEWAY_API_KEY_ENV_VAR=DEEPSEEK_API_KEY
TAROAI_MODEL_GATEWAY_VERIFICATION_SECRET_VALUE_ENV_JSON={}
