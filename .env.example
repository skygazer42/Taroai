TAROAI_SKILL_REGISTRY_BACKEND=memory
TAROAI_KNOWLEDGE_SERVICE_BACKEND=memory
TAROAI_LONG_TERM_MEMORY_BACKEND=memory
TAROAI_SHORT_TERM_MEMORY_BACKEND=memory
TAROAI_REDIS_URL=redis://localhost:6379/0
