# =============================================================================
# Taroai 本地配置
# =============================================================================
# 本文件是可提交的配置模板；复制为 .env 后再填写，禁止在本模板中写入真实密钥。
# 布尔值统一写 true/false；数组和对象必须是合法 JSON，并使用双引号。
# 注释中的“可留空”表示对应能力关闭或由其他配置提供；生产密钥必须改为强随机值。

# =============================================================================
# 一、基础运行与部署
# =============================================================================
# API 文档和界面显示的服务名称；一般无需修改。
TAROAI_API_TITLE="Taroai Control Plane API"
# 运行环境标签；本地填 local 或 local-cloud-poc，正式环境填 production。
TAROAI_ENVIRONMENT=local-cloud-poc
# 部署形态：cloud、byoc、vpc、private 或 air_gapped。
TAROAI_DEPLOYMENT_MODE=cloud
# 用户和外部系统访问 API 的根地址；本地通常为 http://localhost:8000。
TAROAI_DEPLOYMENT_EXTERNAL_URL=http://localhost:8000
# OAuth 等回调地址；必须是外部身份提供方能够访问的完整 URL。
TAROAI_DEPLOYMENT_CALLBACK_URL=http://localhost:8000/api/connectors/oauth/callback
# 部署声明的数据存储区域；必须与对象存储区域一致。
TAROAI_DEPLOYMENT_STORAGE_REGION=us-east-1
# 部署声明的沙盒区域；必须与沙盒提供方区域一致。
TAROAI_DEPLOYMENT_SANDBOX_REGION=us-east-1
# 密钥管理器类型；local 仅适合开发，生产按实际平台选择。
TAROAI_DEPLOYMENT_SECRET_MANAGER_TYPE=aws_secrets_manager

# =============================================================================
# 二、本地 Compose 对外端口
# =============================================================================
# API 暴露到宿主机的端口；只有端口冲突时才修改。
TAROAI_API_PORT=8000
# Web 前端暴露到宿主机的端口；默认使用 3000。
TAROAI_WEB_PORT=3000
# 沙盒控制器暴露到宿主机的端口；容器内部仍使用固定服务端口。
TAROAI_SANDBOX_CONTROLLER_PORT=8002
# PostgreSQL 暴露到宿主机的端口；仅影响宿主机访问。
POSTGRES_PORT=5432
# Redis 暴露到宿主机的端口；仅影响宿主机访问。
REDIS_PORT=6379
# MinIO S3 API 暴露到宿主机的端口。
MINIO_API_PORT=9000
# MinIO 管理控制台暴露到宿主机的端口。
MINIO_CONSOLE_PORT=9001

# =============================================================================
# 三、PostgreSQL 与核心持久化
# =============================================================================
# 本地 PostgreSQL 初始化的数据库名；需与数据库连接串一致。
POSTGRES_DB=taroai
# 本地 PostgreSQL 初始化管理员账号；生产请使用专用账号。
POSTGRES_USER=taroai_admin
# 本地 PostgreSQL 初始化密码；生产必须替换为强随机密码。
POSTGRES_PASSWORD=taroai_admin
# 数据库连接串，格式 postgresql://用户:密码@主机:端口/库名；Compose 内主机名用 postgres。
TAROAI_DATABASE_URL=postgresql://taroai_app:taroai_app@postgres:5432/taroai
# API 保持的最小数据库连接数；小于或等于最大连接数。
TAROAI_DATABASE_POOL_MIN_SIZE=1
# API 允许的最大数据库连接数；按数据库容量和并发调整。
TAROAI_DATABASE_POOL_MAX_SIZE=10
# 从连接池获取连接的最长等待秒数。
TAROAI_DATABASE_POOL_TIMEOUT_SECONDS=30
# 控制面数据后端：memory 重启丢失，sql 持久化；建议使用 sql。
TAROAI_CONTROL_PLANE_STORE_BACKEND=sql
# 用户和身份数据后端：memory 或 sql；正常运行建议 sql。
TAROAI_IDENTITY_SERVICE_BACKEND=sql
# 连接器注册数据后端：memory 或 sql；正常运行建议 sql。
TAROAI_CONNECTOR_REGISTRY_BACKEND=sql
# 用户反馈数据后端：memory 或 sql；需要留存时用 sql。
TAROAI_CUSTOMER_FEEDBACK_SERVICE_BACKEND=sql
# Skill 注册数据后端：memory 或 sql；需要持久化安装状态时用 sql。
TAROAI_SKILL_REGISTRY_BACKEND=sql
# Agent 注册数据后端：memory 或 sql；正常运行建议 sql。
TAROAI_AGENT_REGISTRY_BACKEND=sql
# 浏览器配置档案后端：memory 或 sql；需要跨重启保留时用 sql。
TAROAI_BROWSER_PROFILE_STORE_BACKEND=sql
# Agent 引擎运行数据后端：memory 或 sql；正常运行建议 sql。
TAROAI_AGENT_ENGINE_STORE_BACKEND=sql
# 代码工作区元数据后端：memory 或 sql；正常运行建议 sql。
TAROAI_CODING_WORKSPACE_STORE_BACKEND=sql
# 评测记录后端：memory 或 sql；需要历史记录时用 sql。
TAROAI_EVALUATION_REPOSITORY_BACKEND=sql
# 解决方案包注册数据后端：memory 或 sql；正常运行建议 sql。
TAROAI_SOLUTION_PACK_REGISTRY_BACKEND=sql
# SSO 提供方配置后端：memory 或 sql；生产使用 sql。
TAROAI_SSO_PROVIDER_REGISTRY_BACKEND=sql
# SCIM 同步数据后端：memory 或 sql；生产使用 sql。
TAROAI_SCIM_PROVISIONING_STORE_BACKEND=sql

# =============================================================================
# 四、知识库、记忆与 Redis
# =============================================================================
# 知识库元数据后端：memory 或 sql；需要持久化时用 sql。
TAROAI_KNOWLEDGE_SERVICE_BACKEND=sql
# 知识文档单个分块的最大字符数；过大影响检索精度。
TAROAI_KNOWLEDGE_CHUNK_MAX_CHARACTERS=1200
# 相邻知识分块的重叠字符数；必须小于单块最大字符数。
TAROAI_KNOWLEDGE_CHUNK_OVERLAP_CHARACTERS=120
# 长期记忆后端：memory 或 sql；需要跨重启保留时用 sql。
TAROAI_LONG_TERM_MEMORY_BACKEND=sql
# 短期记忆后端：memory 或 redis；多实例和生产建议 redis。
TAROAI_SHORT_TERM_MEMORY_BACKEND=redis
# Redis 连接地址；Compose 内主机名用 redis，宿主机直接运行用 localhost。
TAROAI_REDIS_URL=redis://redis:6379/0
# 短期记忆存活秒数；到期后自动清理。
TAROAI_SHORT_TERM_MEMORY_TTL_SECONDS=3600

# =============================================================================
# 五、对象存储、上传与数据驻留
# =============================================================================
# MinIO 或 S3 兼容对象存储地址；Compose 内通常使用 http://minio:9000。
TAROAI_OBJECT_STORAGE_ENDPOINT=http://minio:9000
# 存放上传文件和运行产物的对象存储桶名称。
TAROAI_OBJECT_STORAGE_BUCKET=taroai-artifacts
# 对象存储所在区域；必须与部署存储区域一致。
TAROAI_OBJECT_STORAGE_REGION=us-east-1
# 数据驻留主区域；必须包含在允许区域列表中。
TAROAI_DATA_RESIDENCY_PRIMARY_REGION=us-east-1
# 允许存放数据的区域 JSON 数组，例如 ["cn-north-1"]。
TAROAI_DATA_RESIDENCY_ALLOWED_REGIONS=["us-east-1"]
# 跨区域复制策略：disabled、allowed_regions 或 any_region。
TAROAI_DATA_RESIDENCY_CROSS_REGION_REPLICATION_MODE=disabled
# 向量索引所在区域；有数据驻留要求时应放在允许区域内。
TAROAI_VECTOR_INDEX_REGION=us-east-1
# 对象存储访问 Key；本地填 MinIO 账号，生产从密钥系统注入。
TAROAI_OBJECT_STORAGE_ACCESS_KEY_ID=taroai_minio
# 对象存储访问 Secret；生产禁止使用默认值或提交到仓库。
TAROAI_OBJECT_STORAGE_SECRET_ACCESS_KEY=taroai_minio_password
# 对象存储临时签名 URL 的有效秒数。
TAROAI_OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=3600
# 上传内容扫描的禁用词 JSON 数组；空数组表示不按关键词拦截。
TAROAI_OBJECT_STORAGE_CONTENT_SCAN_BLOCKED_TERMS=[]
# 单个上传文件的最大字节数；默认 25000000，约 25 MB。
TAROAI_UPLOAD_MAX_BYTES=25000000
# 允许上传的 MIME 类型 JSON 数组；按业务需要增删，勿写通配符。
TAROAI_UPLOAD_ALLOWED_CONTENT_TYPES=["text/plain","text/markdown","text/csv","application/json","application/pdf","image/png","image/jpeg","image/webp","audio/mpeg","audio/mp4","audio/wav","audio/webm","audio/ogg","application/zip","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
# 存储目录元数据后端：memory 或 sql；正常运行建议 sql。
TAROAI_STORAGE_CATALOG_BACKEND=sql
# 数据生命周期策略后端：memory 或 sql；生产使用 sql。
TAROAI_LIFECYCLE_POLICY_BACKEND=sql
# 恢复演练计划后端：memory 或 sql；需要计划留存时用 sql。
TAROAI_RESTORE_DRILL_SCHEDULE_BACKEND=sql

# =============================================================================
# 六、密钥服务
# =============================================================================
# 业务密钥服务后端：本地 Compose 用 local；生产使用 aws_secrets_manager。
TAROAI_SECRET_SERVICE_BACKEND=local
# local 后端的加密 SQLite 文件；密钥文件会在同目录自动生成，勿提交或复制到公开位置。
TAROAI_SECRET_SERVICE_LOCAL_PATH=/data/taroai/secrets.db
# 外部密钥服务所在区域。
TAROAI_SECRET_SERVICE_REGION=us-east-1
# 密钥服务自定义地址；直连 AWS 时可留空，本地模拟器填写其 URL。
TAROAI_SECRET_SERVICE_ENDPOINT_URL=
# 在外部密钥服务中创建密钥时使用的名称前缀。
TAROAI_SECRET_SERVICE_NAME_PREFIX=taroai/local-cloud-poc
# 用于加密密钥内容的 KMS Key ID；不使用自管 KMS 时可留空。
TAROAI_SECRET_SERVICE_KMS_KEY_ID=

# =============================================================================
# 七、API 侧沙盒入口与容量
# =============================================================================
# 代码执行沙盒：disabled、local_process、docker、e2b 或 k8s；生产不要使用 local_process。
TAROAI_SANDBOX_PROVIDER=local_process
# 沙盒提供方区域；必须与部署沙盒区域一致。
TAROAI_SANDBOX_PROVIDER_REGION=us-east-1
# local_process 沙盒的本地根目录；不用本地进程沙盒时通常无需修改。
TAROAI_SANDBOX_ROOT_DIR=/data/taroai/sandboxes
# Docker/Kubernetes 沙盒镜像；生产建议固定不可变 digest。
TAROAI_SANDBOX_RUNTIME_IMAGE=python:3.12-slim
# 单次沙盒命令允许执行的最长秒数。
TAROAI_SANDBOX_TIMEOUT_SECONDS=300
# 沙盒网络：disabled、allowlist 或 open；未明确需要联网时保持 disabled。
TAROAI_SANDBOX_NETWORK_MODE=disabled
# API 侧允许的沙盒总会话上限。
TAROAI_SANDBOX_MAX_SESSIONS=50
# 单个租户允许的沙盒并发会话上限。
TAROAI_SANDBOX_MAX_SESSIONS_PER_TENANT=20
# 单次 Run 允许创建的沙盒会话上限。
TAROAI_SANDBOX_MAX_SESSIONS_PER_RUN=3
# 沙盒读取临时密钥的鉴权 Token；不用该能力可留空，启用时至少 32 位随机值。
TAROAI_SANDBOX_SECRET_RESOLVER_TOKEN=
# API 访问沙盒控制器的地址；Compose 内通常为 http://sandbox-controller:8002。
TAROAI_SANDBOX_CONTROLLER_BASE_URL=
# API 与沙盒控制器共享的鉴权 Key；两端必须一致，生产至少 32 位随机值。
TAROAI_SANDBOX_CONTROLLER_API_KEY=local_sandbox_controller_key_2026_dev_only
# API 请求沙盒控制器的超时秒数。
TAROAI_SANDBOX_CONTROLLER_TIMEOUT_SECONDS=30
# E2B API Key；仅在 TAROAI_SANDBOX_PROVIDER=e2b 时填写，禁止提交真实值。
TAROAI_E2B_API_KEY=
# E2B 模板名称或 ID；留空使用官方 base 模板。
TAROAI_E2B_TEMPLATE=
# API 调用 E2B 控制面的超时秒数。
TAROAI_E2B_REQUEST_TIMEOUT_SECONDS=30
# 单个 E2B 沙盒允许的最长存活秒数；免费档建议不超过 3600。
TAROAI_E2B_MAX_SESSION_TTL_SECONDS=3600

# =============================================================================
# 八、沙盒控制器通用配置
# =============================================================================
# 控制器实际创建沙盒的方式：本地开发用 docker，集群使用 kubernetes。
TAROAI_SANDBOX_CONTROLLER_PROVIDER=docker
# 控制器中沙盒会话的最长存活秒数。
TAROAI_SANDBOX_CONTROLLER_SESSION_TTL_SECONDS=1800
# 控制器允许的沙盒总并发上限；应与基础设施容量匹配。
TAROAI_SANDBOX_CONTROLLER_MAX_SESSIONS=50
# 控制器允许单租户占用的沙盒并发上限。
TAROAI_SANDBOX_CONTROLLER_MAX_SESSIONS_PER_TENANT=20
# 控制器允许单次 Run 创建的沙盒会话上限。
TAROAI_SANDBOX_CONTROLLER_MAX_SESSIONS_PER_RUN=3

# =============================================================================
# 九、沙盒控制器 Docker 配置
# =============================================================================
# 控制器创建 Docker 沙盒时的内存限制，例如 512m 或 1g。
TAROAI_SANDBOX_CONTROLLER_DOCKER_MEMORY_LIMIT=1g
# 控制器创建 Docker 沙盒时可使用的 CPU 核数。
TAROAI_SANDBOX_CONTROLLER_DOCKER_CPUS=1.0
# 控制器创建 Docker 沙盒时允许的最大进程数。
TAROAI_SANDBOX_CONTROLLER_DOCKER_PIDS_LIMIT=256
# Docker 沙盒内运行命令的 UID:GID；应使用非 root 用户。
TAROAI_SANDBOX_CONTROLLER_DOCKER_USER=65532:65532
# 是否将 Docker 沙盒根文件系统设为只读；建议保持 true。
TAROAI_SANDBOX_CONTROLLER_DOCKER_READ_ONLY_ROOTFS=true
# 是否移除 Docker 沙盒全部 Linux capabilities；建议保持 true。
TAROAI_SANDBOX_CONTROLLER_DOCKER_DROP_ALL_CAPABILITIES=true
# Docker 安全选项 JSON 数组，例如 no-new-privileges:true。
TAROAI_SANDBOX_CONTROLLER_DOCKER_SECURITY_OPTS=["no-new-privileges:true"]
# Docker 沙盒临时可写目录 JSON 数组；数据会随容器销毁。
TAROAI_SANDBOX_CONTROLLER_DOCKER_TMPFS_MOUNTS=["/tmp:rw,noexec,nosuid,size=256m"]

# =============================================================================
# 十、沙盒控制器 Kubernetes / gVisor 配置
# =============================================================================
# Kubernetes 沙盒 Pod 所在命名空间。
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_NAMESPACE=default
# kubectl 可执行文件路径或命令名；通常保持 kubectl。
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_KUBECTL_BINARY=kubectl
# 沙盒 Pod 使用的 ServiceAccount 名称；应按最小权限配置。
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_SERVICE_ACCOUNT_NAME=sandbox-runner
# 沙盒 Pod 的 RuntimeClass；使用 gVisor 时通常填 gvisor。
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_RUNTIME_CLASS_NAME=gvisor
# 是否强制 RuntimeClass 可用；生产隔离场景建议 true。
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_RUNTIME_CLASS_REQUIRED=true
# 允许运行的沙盒镜像 JSON 数组；生产建议使用带 digest 的精确白名单。
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_ALLOWED_IMAGES=["ghcr.io/customer/sandbox-runtime@sha256:*"]
# 是否清理孤儿沙盒 Pod；确认控制器状态可靠后再开启。
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_ORPHAN_CLEANUP_ENABLED=false
# 沙盒镜像拉取策略，常用 IfNotPresent 或 Always。
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_IMAGE_PULL_POLICY=IfNotPresent
# 等待沙盒 Pod Ready 的最长秒数。
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_POD_READY_TIMEOUT_SECONDS=60
# 每个 Kubernetes 沙盒 Pod 的内存上限，例如 512Mi。
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_MEMORY_LIMIT=1Gi
# 每个 Kubernetes 沙盒 Pod 的 CPU 上限，例如 500m。
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_CPU_LIMIT=1000m
# 每个沙盒 Pod 的临时磁盘上限，例如 1Gi。
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_EPHEMERAL_STORAGE_LIMIT=2Gi
# 沙盒 Pod 的非 root 用户 UID。
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_RUN_AS_USER=65532
# 沙盒 Pod 的非 root 用户组 GID。
TAROAI_SANDBOX_CONTROLLER_KUBERNETES_RUN_AS_GROUP=65532

# =============================================================================
# 十一、API 直连 Docker 沙盒配置
# =============================================================================
# API 直连 Docker 沙盒时的内存限制，例如 512m。
TAROAI_SANDBOX_DOCKER_MEMORY_LIMIT=1g
# API 直连 Docker 沙盒时可使用的 CPU 核数。
TAROAI_SANDBOX_DOCKER_CPUS=1.0
# API 直连 Docker 沙盒时允许的最大进程数。
TAROAI_SANDBOX_DOCKER_PIDS_LIMIT=256
# API 直连 Docker 沙盒内的 UID:GID；应使用非 root 用户。
TAROAI_SANDBOX_DOCKER_USER=65532:65532
# API 直连 Docker 时是否使用只读根文件系统；建议保持 true。
TAROAI_SANDBOX_DOCKER_READ_ONLY_ROOTFS=true
# API 直连 Docker 时是否移除全部 capabilities；建议保持 true。
TAROAI_SANDBOX_DOCKER_DROP_ALL_CAPABILITIES=true
# API 直连 Docker 时的安全选项 JSON 数组。
TAROAI_SANDBOX_DOCKER_SECURITY_OPTS=["no-new-privileges:true"]
# API 直连 Docker 时的临时可写目录 JSON 数组。
TAROAI_SANDBOX_DOCKER_TMPFS_MOUNTS=["/tmp:rw,noexec,nosuid,size=256m"]

# =============================================================================
# 十二、浏览器自动化
# =============================================================================
# 浏览器自动化提供方：disabled、playwright 或 browserbase；不用时保持 disabled。
TAROAI_BROWSER_PROVIDER=disabled
# API 访问浏览器控制器的地址；启用浏览器能力时必须可达。
TAROAI_BROWSER_CONTROLLER_BASE_URL=http://browser-controller:8001
# API 与浏览器控制器共享的鉴权 Key；两端一致，生产至少 32 位随机值。
TAROAI_BROWSER_CONTROLLER_API_KEY=local_browser_controller_key_2026_dev_only
# 浏览器控制器暴露到宿主机的端口；仅端口冲突时修改。
TAROAI_BROWSER_CONTROLLER_PORT=8001
# API 请求浏览器控制器的超时秒数。
TAROAI_BROWSER_CONTROLLER_TIMEOUT_SECONDS=30
# 浏览器会话的最长存活秒数。
TAROAI_BROWSER_CONTROLLER_SESSION_TTL_SECONDS=1800
# 浏览器控制器允许的总并发会话上限。
TAROAI_BROWSER_CONTROLLER_MAX_SESSIONS=50
# 浏览器控制器允许单租户的并发会话上限。
TAROAI_BROWSER_CONTROLLER_MAX_SESSIONS_PER_TENANT=20
# 浏览器控制器允许单次 Run 的会话上限。
TAROAI_BROWSER_CONTROLLER_MAX_SESSIONS_PER_RUN=3
# 允许浏览器导航的主机名 JSON 数组；启用浏览器时必须非空，支持 *.example.com。
TAROAI_BROWSER_CONTROLLER_NAVIGATION_ALLOWED_HOSTS=[]
# Tavily Search API Key；留空不注册 web.search 工具，禁止提交真实值。
TAROAI_TAVILY_API_KEY=
# Tavily 单次搜索请求超时秒数。
TAROAI_TAVILY_TIMEOUT_SECONDS=15

# =============================================================================
# 十三、外部分享与线程分享
# =============================================================================
# 是否允许生成外部分享链接；不需要公开分享时保持 false。
TAROAI_EXTERNAL_SHARE_LINKS_ENABLED=false
# 外部分享 Token 的哈希密钥；启用分享时填写至少 32 位随机值。
TAROAI_EXTERNAL_SHARE_LINK_TOKEN_HASH_SECRET=
# 分享授权记录后端：memory 或 sql；需要持久化时用 sql。
TAROAI_SHARE_GRANT_STORE_BACKEND=sql
# 会话线程分享记录后端：memory 或 sql；正常运行建议 sql。
TAROAI_THREAD_SHARE_STORE_BACKEND=sql
# 线程分享 Token 的哈希密钥；本地值仅供开发，生产必须换成至少 32 位随机值。
TAROAI_THREAD_SHARE_TOKEN_HASH_SECRET=local_thread_share_token_hash_secret_change_me

# =============================================================================
# 十四、模型网关
# =============================================================================
# OpenAI 兼容模型接口根地址，通常以 /v1 结尾。
TAROAI_MODEL_GATEWAY_BASE_URL=https://api.openai.com/v1
# 模型提供方 API Key；仅适合本地直填，生产优先使用密钥引用。
TAROAI_MODEL_GATEWAY_API_KEY=
# 密钥服务中的模型 API Key 引用 ID；直填 API Key 时可留空。
TAROAI_MODEL_GATEWAY_API_KEY_SECRET_REF_ID=
# 从密钥服务租用模型 Key 的缓存秒数。
TAROAI_MODEL_GATEWAY_SECRET_LEASE_TTL_SECONDS=60
# 默认聊天模型 ID；留空表示不配置默认模型网关。
TAROAI_MODEL_GATEWAY_MODEL=
# 单次模型请求的超时秒数。
TAROAI_MODEL_GATEWAY_TIMEOUT_SECONDS=30
# 附加到聊天请求的 JSON 对象；无额外参数时填 {}。
TAROAI_MODEL_GATEWAY_CHAT_REQUEST_OPTIONS={}
# 模型支持的思考强度；不支持调节时保持空数组。
TAROAI_MODEL_GATEWAY_REASONING_EFFORTS=[]
# 默认思考强度，必须包含在上一项中；留空表示由模型提供方决定。
TAROAI_MODEL_GATEWAY_DEFAULT_REASONING_EFFORT=
# 多模型提供方配置 JSON 数组；单提供方可留空数组并使用上面的简易配置。
TAROAI_MODEL_GATEWAY_PROVIDERS=[]

# =============================================================================
# 十五、Embedding 网关
# =============================================================================
# 是否启用向量嵌入服务；知识检索和跨语言长期记忆召回需要时设为 true。
TAROAI_EMBEDDING_GATEWAY_ENABLED=false
# OpenAI 兼容 Embedding 接口根地址。
TAROAI_EMBEDDING_GATEWAY_BASE_URL=https://api.openai.com/v1
# Embedding 提供方 API Key；生产优先使用密钥引用。
TAROAI_EMBEDDING_GATEWAY_API_KEY=
# 密钥服务中的 Embedding API Key 引用 ID；直填时可留空。
TAROAI_EMBEDDING_GATEWAY_API_KEY_SECRET_REF_ID=
# 从密钥服务租用 Embedding Key 的缓存秒数。
TAROAI_EMBEDDING_GATEWAY_SECRET_LEASE_TTL_SECONDS=60
# Embedding 模型 ID；必须是提供方实际支持的名称。
TAROAI_EMBEDDING_GATEWAY_MODEL=
# 向量维度；留空采用模型默认维度，填写时必须为正整数。
TAROAI_EMBEDDING_GATEWAY_DIMENSIONS=
# 单次 Embedding 请求的超时秒数。
TAROAI_EMBEDDING_GATEWAY_TIMEOUT_SECONDS=30

# =============================================================================
# 十六、计费、模型策略与预算
# =============================================================================
# 模型计价规则 JSON 数组；空数组表示不从环境变量预置规则。
TAROAI_BILLING_PRICING_RULES=[]
# 计价规则后端：memory 或 sql；需要后台维护和持久化时用 sql。
TAROAI_BILLING_PRICING_RULE_STORE_BACKEND=sql
# 账单后端：memory 或 sql；需要正式计费记录时用 sql。
TAROAI_BILLING_INVOICE_STORE_BACKEND=sql
# 允许调用的模型 ID JSON 数组；空数组表示不设置允许名单。
TAROAI_MODEL_GATEWAY_ALLOWED_MODELS=[]
# 禁止调用的模型 ID JSON 数组。
TAROAI_MODEL_GATEWAY_DENIED_MODELS=[]
# 不同数据敏感级别可用模型的 JSON 映射；无特殊限制时填 {}。
TAROAI_MODEL_GATEWAY_SENSITIVITY_LIMITS={}
# 模型策略作用域 JSON 数组；按租户、工作区等实际策略配置。
TAROAI_MODEL_GATEWAY_POLICY_SCOPES=[]
# 模型访问策略后端：memory 或 sql；多实例和生产使用 sql。
TAROAI_MODEL_GATEWAY_POLICY_STORE_BACKEND=sql
# 模型提供方配置后端：memory 或 sql；需要动态配置时用 sql。
TAROAI_MODEL_GATEWAY_PROVIDER_STORE_BACKEND=sql
# 提供方限流后端：memory、sql 或 redis；多实例建议 redis。
TAROAI_MODEL_GATEWAY_PROVIDER_RATE_LIMIT_BACKEND=sql
# 单个 Run 的模型调用次数上限；0 表示不限制。
TAROAI_MODEL_GATEWAY_RUN_CALL_LIMIT=0
# 单个 Run 的 Token 上限；0 表示不限制。
TAROAI_MODEL_GATEWAY_RUN_TOKEN_LIMIT=0
# 单个租户在预算窗口内的模型调用次数上限；0 表示不限制。
TAROAI_MODEL_GATEWAY_TENANT_CALL_LIMIT=0
# 单个租户在预算窗口内的 Token 上限；0 表示不限制。
TAROAI_MODEL_GATEWAY_TENANT_TOKEN_LIMIT=0
# 单个工作区在预算窗口内的模型调用次数上限；0 表示不限制。
TAROAI_MODEL_GATEWAY_WORKSPACE_CALL_LIMIT=0
# 单个工作区在预算窗口内的 Token 上限；0 表示不限制。
TAROAI_MODEL_GATEWAY_WORKSPACE_TOKEN_LIMIT=0
# 单个用户在预算窗口内的模型调用次数上限；0 表示不限制。
TAROAI_MODEL_GATEWAY_USER_CALL_LIMIT=0
# 单个用户在预算窗口内的 Token 上限；0 表示不限制。
TAROAI_MODEL_GATEWAY_USER_TOKEN_LIMIT=0
# 单个 Agent 在预算窗口内的模型调用次数上限；0 表示不限制。
TAROAI_MODEL_GATEWAY_AGENT_CALL_LIMIT=0
# 单个 Agent 在预算窗口内的 Token 上限；0 表示不限制。
TAROAI_MODEL_GATEWAY_AGENT_TOKEN_LIMIT=0
# 租户等预算统计窗口秒数；小于等于 0 表示不滚动、按全部历史统计。
TAROAI_MODEL_GATEWAY_BUDGET_WINDOW_SECONDS=0

# =============================================================================
# 十七、Guardrails 安全检测
# =============================================================================
# 是否启用内置敏感密钥检测。
TAROAI_GUARDRAIL_SECRET_DETECTOR_ENABLED=false
# 检测到密钥后的动作：warn、redact、require_approval 或 block。
TAROAI_GUARDRAIL_SECRET_DETECTOR_ACTION=redact
# 执行密钥检测的阶段 JSON 数组，例如输入、输出或工具调用阶段。
TAROAI_GUARDRAIL_SECRET_DETECTOR_STAGES=["input","model_request","model_response","tool_request","tool_response","artifact","memory_write"]
# 是否启用提示词攻击和越权意图检测。
TAROAI_GUARDRAIL_PROMPT_THREAT_DETECTOR_ENABLED=false
# 检测到提示词威胁后的动作：warn、redact、require_approval 或 block。
TAROAI_GUARDRAIL_PROMPT_THREAT_DETECTOR_ACTION=block
# 执行提示词威胁检测的阶段 JSON 数组。
TAROAI_GUARDRAIL_PROMPT_THREAT_DETECTOR_STAGES=["input","model_request","tool_request","memory_write"]
# 是否调用外部 HTTP Guardrail 服务。
TAROAI_GUARDRAIL_HTTP_DETECTOR_ENABLED=false
# 外部 Guardrail 服务 URL；未启用 HTTP 检测时可留空。
TAROAI_GUARDRAIL_HTTP_DETECTOR_URL=
# 外部 Guardrail 服务鉴权 Key；未启用时可留空。
TAROAI_GUARDRAIL_HTTP_DETECTOR_API_KEY=
# 调用外部 Guardrail 服务的超时秒数。
TAROAI_GUARDRAIL_HTTP_DETECTOR_TIMEOUT_SECONDS=5
# 外部检测服务故障时的动作：allow、warn、require_approval 或 block。
TAROAI_GUARDRAIL_HTTP_DETECTOR_FAILURE_ACTION=allow
# 调用外部 Guardrail 服务的阶段 JSON 数组。
TAROAI_GUARDRAIL_HTTP_DETECTOR_STAGES=["input","model_request","model_response","tool_request","tool_response","artifact","memory_write"]

# =============================================================================
# 十八、登录、会话与租户
# =============================================================================
# 密码哈希迭代次数；生产不得低于 600000。
TAROAI_PASSWORD_HASH_ITERATIONS=600000
# 密码哈希盐；生产使用至少 32 位随机值，并保持稳定以免旧密码失效。
TAROAI_PASSWORD_HASH_SALT=local_cloud_poc_password_salt
# 访问令牌签名密钥；生产使用至少 32 位随机值并安全保存。
TAROAI_ACCESS_TOKEN_SECRET=local_cloud_poc_access_token_key
# 登录访问令牌有效秒数。
TAROAI_ACCESS_TOKEN_TTL_SECONDS=3600
# 勾选“记住我”后的登录有效秒数；默认 30 天，注销后仍会立即失效。
TAROAI_REMEMBERED_ACCESS_TOKEN_TTL_SECONDS=2592000
# 登录会话后端：auto、memory 或 sql；生产和多实例使用 sql。
TAROAI_AUTH_SESSION_BACKEND=auto
# 是否开放生产自助注册；开启后必须同时配置外部访问 URL 和 SMTP。
TAROAI_AUTH_PUBLIC_REGISTRATION_ENABLED=false
# 是否开放“忘记密码”；开启后必须同时配置外部访问 URL 和 SMTP。
TAROAI_AUTH_PASSWORD_RESET_ENABLED=false
# SMTP 连接 URL；支持 smtp://（STARTTLS）或 smtps://，账号密码需 URL 编码。
TAROAI_AUTH_SMTP_URL=
# 验证和重置邮件的发件地址。
TAROAI_AUTH_EMAIL_FROM=
# 邮箱验证链接有效秒数，默认 24 小时。
TAROAI_AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
# 密码重置链接有效秒数，默认 1 小时。
TAROAI_AUTH_PASSWORD_RESET_TTL_SECONDS=3600
# 是否允许开发请求头伪造身份；生产必须设为 false。
TAROAI_DEV_REQUEST_HEADERS_ENABLED=false
# 创建首个租户/管理员使用的引导 Token；生产至少 32 位随机值。
TAROAI_TENANT_BOOTSTRAP_TOKEN=local_bootstrap_token
# 默认租户配额档位：trial、poc、business 或 enterprise。
TAROAI_TENANT_QUOTA_PROFILE=poc

# =============================================================================
# 十九、审计与链路追踪
# =============================================================================
# 审计日志保留天数；按合规和存储成本调整。
TAROAI_AUDIT_RETENTION_DAYS=365
# 链路追踪导出：disabled 或 otlp_http；不用时保持 disabled。
TAROAI_TRACE_EXPORTER_BACKEND=disabled
# OTLP HTTP 接收地址；未启用追踪导出时可留空。
TAROAI_TRACE_EXPORTER_ENDPOINT_URL=
# 追踪平台鉴权 Key；未启用或平台不要求时可留空。
TAROAI_TRACE_EXPORTER_API_KEY=
# 导出链路追踪数据的请求超时秒数。
TAROAI_TRACE_EXPORTER_TIMEOUT_SECONDS=5
# 追踪平台中显示的服务名称。
TAROAI_TRACE_EXPORTER_SERVICE_NAME=taroai-api

# =============================================================================
# 二十、Agent 循环、队列与 Worker
# =============================================================================
# 后台任务队列：disabled 或 redis；使用 Worker 时设为 redis。
TAROAI_JOB_QUEUE_BACKEND=redis
# Run 执行方式：Compose 已启动 Agent Worker，因此交给 Redis 队列。
TAROAI_RUN_EXECUTION_DISPATCH_MODE=queue
# 单次 Agent Run 允许的最大循环轮数，防止无限执行。
TAROAI_AGENT_LOOP_MAX_ITERATIONS=12
# 单次 Agent Run 允许自动修复失败步骤的最大次数；0 表示不修复。
TAROAI_AGENT_LOOP_MAX_REPAIRS=4
# 整个 Agent 循环允许运行的最长秒数。
TAROAI_AGENT_LOOP_TIMEOUT_SECONDS=1800
# 单次 Agent Run 的成本上限；0 表示不启用成本封顶。
TAROAI_AGENT_LOOP_COST_LIMIT=0
# Worker 领取一个 Agent 动作后的租约秒数；应大于正常动作耗时。
TAROAI_AGENT_LOOP_ACTION_LEASE_SECONDS=600
# 全自动执行是否强制要求隔离沙盒；为安全起见建议保持 true。
TAROAI_AGENT_LOOP_FULL_AUTO_REQUIRES_ISOLATION=true
# Run 执行队列名称；除非多个系统共用 Redis，否则无需修改。
TAROAI_RUN_EXECUTION_QUEUE_NAME=runs.execute
# 计费聚合队列名称；通常无需修改。
TAROAI_BILLING_QUEUE_NAME=billing.aggregate
# 过期资源清理队列名称；通常无需修改。
TAROAI_CLEANUP_QUEUE_NAME=system.cleanup
# 定时器和 Trigger 队列名称；通常无需修改。
TAROAI_TRIGGER_QUEUE_NAME=triggers.due
# Worker 领取任务后的租约秒数；任务超时后可被重新领取。
TAROAI_WORKER_JOB_LEASE_SECONDS=300
# 任务失败后再次尝试前等待的秒数。
TAROAI_WORKER_JOB_RETRY_DELAY_SECONDS=30
# 后台任务最多尝试次数；包含首次执行。
TAROAI_WORKER_JOB_MAX_ATTEMPTS=3

# =============================================================================
# 二十一、Trigger 与 Webhook
# =============================================================================
# Trigger 与定时任务数据后端：memory 或 sql；需要可靠调度时用 sql。
TAROAI_TRIGGER_STORE_BACKEND=sql
# Webhook 签名密钥 JSON 数组；生产至少配置一个强随机值，轮换时可暂留新旧两个。
TAROAI_TRIGGER_WEBHOOK_SIGNING_SECRETS=["replace-with-webhook-signing-secret"]
# Webhook 时间戳与服务器时间允许的最大偏差秒数。
TAROAI_TRIGGER_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
# 是否接受无签名 Webhook；生产必须保持 false。
TAROAI_TRIGGER_WEBHOOK_ALLOW_UNSIGNED=false
# Trigger 操作超过多少秒未完成后视为卡住。
TAROAI_TRIGGER_OPERATIONS_STUCK_AFTER_SECONDS=900

# =============================================================================
# 二十二、License、CORS、事件流、语音与迁移
# =============================================================================
# License 验签公钥 JSON 对象，格式为 {"key_id":"Base64公钥"}。
TAROAI_LICENSE_TRUSTED_PUBLIC_KEYS={}
# 是否在运行时强制校验 License；本地开发通常为 false。
TAROAI_LICENSE_RUNTIME_ENFORCEMENT_ENABLED=false
# 允许跨域访问 API 的前端来源 JSON 数组；生产只填写可信域名。
TAROAI_CORS_ORIGINS=["http://localhost:3000","http://localhost:3300","http://web"]
# 事件流响应类型；SSE 必须保持 text/event-stream。
TAROAI_EVENT_STREAM_MEDIA_TYPE=text/event-stream
# SSE 无业务事件时发送心跳的间隔秒数。
TAROAI_EVENT_STREAM_HEARTBEAT_SECONDS=10
# SSE 单次持续跟随新事件的最长秒数。
TAROAI_EVENT_STREAM_FOLLOW_SECONDS=30
# 语音能力提供方；当前仅支持 disabled，表示关闭。
TAROAI_SPEECH_PROVIDER=disabled
# 单个语音文件允许的最大字节数；默认 10000000，约 10 MB。
TAROAI_SPEECH_MAX_AUDIO_BYTES=10000000
# 启动时是否自动执行数据库迁移；本地可为 true，生产通常交给独立迁移任务。
TAROAI_RUN_MIGRATIONS=true
