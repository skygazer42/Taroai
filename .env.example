TAROAI_MODEL_GATEWAY_AGENT_TOKEN_LIMIT=0
TAROAI_GUARDRAIL_SECRET_DETECTOR_ENABLED=false
TAROAI_GUARDRAIL_SECRET_DETECTOR_ACTION=redact
TAROAI_GUARDRAIL_SECRET_DETECTOR_STAGES=["input","model_request","model_response","tool_request","tool_response","artifact","memory_write"]
TAROAI_GUARDRAIL_PROMPT_THREAT_DETECTOR_ENABLED=false
TAROAI_GUARDRAIL_PROMPT_THREAT_DETECTOR_ACTION=block
TAROAI_GUARDRAIL_PROMPT_THREAT_DETECTOR_STAGES=["input","model_request","tool_request","memory_write"]
