TAROAI_GUARDRAIL_HTTP_DETECTOR_FAILURE_ACTION=allow
TAROAI_GUARDRAIL_HTTP_DETECTOR_STAGES=["input","model_request","model_response","tool_request","tool_response","artifact","memory_write"]
TAROAI_PASSWORD_HASH_ITERATIONS=600000
TAROAI_PASSWORD_HASH_SALT=change_me_in_production
TAROAI_ACCESS_TOKEN_SECRET=change_me_in_production
